// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AssignmentRule {
  id        String   @id @default(cuid())
  shop      String
  chartId   String   // metaobject GID
  type      String   // product | collection | product_type | vendor | tag
  value     String   // GID for product/collection, text otherwise
  label     String   // what the merchant sees (product title, collection title, the text)
  priority  Int
  createdAt DateTime @default(now())

  @@index([shop, priority])
}

model ShopState {
  shop                 String    @id
  onboardedAt          DateTime?
  sizeOptionNames      String    @default("Size")
  syncRequestedAt      DateTime?
  syncStartedAt        DateTime?
  syncFinishedAt       DateTime?
  syncError            String?
  syncCounts           String? // JSON {checked,set,unset}
  rulesManaged         Boolean   @default(false) // set on the first rule insert: from then on, no rules = unset every product
  timezone             String? // shop.ianaTimezone (written by Task 3); events count in UTC until known
  shopGid              String? // gid://shopify/Shop/…
  installationId       String? // currentAppInstallation.id
  planHandle           String? // spec §5; activeSubscription.items[0].handle
  billingPeriod        String? // e.g. EVERY_30_DAYS, ANNUAL
  trialEndsAt          DateTime?
  entitled             Boolean   @default(false)
  entitlementCheckedAt DateTime? // last confirmed Partner answer
  entitlementWritten   Boolean? // last value written to tsc.active (null = never)
  proxyStatus          String? // ok | moved | unknown, from probing /apps/tsc/ping
  proxyCheckedAt       DateTime?
}

// Storefront finder counters, one row per chart and shop-local day. Incremented at write time.
model EventDaily {
  shop        String
  chartKey    String // metaobject handle (FinderConfig.chart.key)
  date        String // YYYY-MM-DD, shop-local
  opens       Int    @default(0)
  completions Int    @default(0)
  addToCarts  Int    @default(0)

  @@id([shop, chartKey, date])
}

// Recommended sizes from completions, at most MAX_SIZES_PER_DAY rows per chart and day.
model EventSizeDaily {
  shop     String
  chartKey String
  date     String
  size     String // recommended size label, as sent
  count    Int    @default(0)

  @@id([shop, chartKey, date, size])
}

// A named lock with an expiry, so one process at a time runs a background job.
model JobLease {
  name        String   @id
  holder      String
  lockedUntil DateTime
}
